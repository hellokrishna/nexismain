# Public site URL used for canonical links, Open Graph, and the sitemap.
NEXT_PUBLIC_SITE_URL=https://nexisfitness.com

# Google Search Console HTML-tag verification code (the content= value only).
# Example: if Google gives content="AbCdEf123", put AbCdEf123 here.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional Laravel origin, with no trailing slash.
# When set, packages, reviews, posts, FAQs, and features are read from the API,
# and the contact form posts to /api/inquiries.
LARAVEL_API_URL=
LARAVEL_API_TOKEN=

# Password for the desk at /admin. Choose a long one before you publish.
ADMIN_PASSWORD=
